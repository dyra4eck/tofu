#cloud-config
hostname: ${vm_name}
manage_etc_hosts: true
ssh_pwauth: true
users:
  - name: admin
    groups: wheel
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    passwd: ${password_hash}
    ssh_authorized_keys:
%{ for key in ssh_keys ~}
       - ${key}
%{ endfor ~}

packages:
  - qemu-guest-agent
  - python39
runcmd:
  - systemctl enable --now qemu-guest-agent
